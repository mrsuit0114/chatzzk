# VOD Context Project Environment Configuration
# Copy this file to .env and modify the values as needed

# Data Directory Configuration
VOD_DATA_DIR=data
VOD_VIDEO_DIR=videos
VOD_AUDIO_DIR=audios
VOD_CHAT_CONTEXT_DIR=chat_contexts
VOD_VAD_DIR=vads
VOD_ASR_CONTEXT_DIR=asr_contexts
VOD_FULL_CONTEXT_DIR=full_contexts

# User Agent (for web requests)
VOD_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36

# Cookie Configuration
VOD_COOKIES_FILE=cookies.json

# Network Configuration
VOD_MAX_RETRIES=3
VOD_TIMEOUT=30

# Audio Processing Configuration
VOD_TARGET_SAMPLING_RATE=16000

# Chat Crawling Configuration
VOD_CHAT_MAX_RETRIES=3
VOD_CHAT_BASE_SLEEP_TIME=0.5

# ASR Configuration
VOD_ASR_MODEL_SIZE=large-v3
VOD_MIN_SILENCE_DURATION_MS=500
VOD_MAX_SPEECH_DURATION_S=30
VOD_WHISPERX_MODEL_DIR=/app/whisperx_models
VOD_COMPUTE_TYPE=float16
VOD_BATCH_SIZE=4

# Context Merging Configuration
VOD_ASR_OFFSET_MS=500
